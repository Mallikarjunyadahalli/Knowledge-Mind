```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
venv/
env/
ENV/

# Environment variables / API keys
.env
.env.*
!.env.example

# Streamlit
.streamlit/secrets.toml

# ChromaDB / Vector Database
chroma_db/
chroma/
*.db
*.sqlite
*.sqlite3

# Uploaded documents
data/uploads/
data/

# Jupyter Notebook
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Python cache
.pytest_cache/
.mypy_cache/

# Build files
build/
dist/
*.egg-info/

# Temporary files
*.tmp
*.temp
```